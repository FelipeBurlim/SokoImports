# URL da API (Spring Boot)
NEXT_PUBLIC_API_URL=http://localhost:8080/api

# ---------------- Painel administrativo (/admin) ----------------
# IMPORTANTE: nunca coloque o prefixo NEXT_PUBLIC_ nestas variáveis,
# senão elas vão parar no navegador.

# Senha de acesso ao painel (mínimo 8 caracteres)
ADMIN_PASSWORD=troque-por-uma-senha-forte

# Mesma chave configurada no backend (ADMIN_API_KEY). Mínimo 24 caracteres.
ADMIN_API_KEY=

# Segredo que assina o cookie de login. Mínimo 32 caracteres.
SESSION_SECRET=

# Gere valores aleatórios com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
